---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

// `main` below is a flex item (its wrapper is `md:flex`), so by default it is
// shrink-to-fit: it sizes to its content's max-content width and only then gets
// clamped by max-w. Pages with long prose hit the clamp and look full-width;
// pages whose content is short — a list of titles and badges — end up visibly
// narrower than the rest of the site. `fillWidth` opts a page into filling the
// column regardless of how much content it has.
const { image, title = SITE_TITLE, description = SITE_DESCRIPTION, includeSidebar = true, sideBarActiveItemID, wide = false, fillWidth = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="lofi">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      {/* `min-w-0`: the drawer content is a grid item, so its default
          `min-width: auto` lets any wide descendant — a fixed-size figure, a
          long code line — widen the whole page instead of being clamped. */}
      <div class="drawer-content bg-base-100 min-w-0">
        <Header title={SITE_TITLE} />
        <div class="md:flex md:justify-center">
          <main class={`p-6 pt-10 ${fillWidth ? "w-full" : ""} ${wide ? "max-w-[1200px]" : "max-w-[900px]"}`}>
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>
  </body>
</html>
