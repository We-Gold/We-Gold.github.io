---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceTimeLine from "../components/experience/ExperienceTimeLine.astro";
import SkillGraph from "../components/experience/SkillGraph.astro";
import { experienceEntries } from "../data/experience";
---

<BaseLayout title="Experience" sideBarActiveItemID="experience" wide={true}>
  <div class="text-3xl w-full font-bold mb-2">Experience</div>
  <p class="mb-6 text-sm opacity-70 max-w-2xl">
    Work history and projects, and how they connect to my main skill areas. Scroll to see which
    entry's skills are highlighted, or click one to pin it until you scroll again; hover a skill
    to see everywhere it shows up.
  </p>

  <div class="filter-bar flex gap-2 mb-6">
    <button type="button" data-filter="all" class="btn btn-sm btn-active">All</button>
    <button type="button" data-filter="work" class="btn btn-sm">Work</button>
    <button type="button" data-filter="project" class="btn btn-sm">Projects</button>
  </div>

  <div class="experience-layout grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-8 items-start relative">
    <svg id="tendril-overlay" class="tendril-overlay pointer-events-none hidden lg:block"></svg>
    <div id="tendril-css-layer" class="tendril-css-layer pointer-events-none hidden lg:block" aria-hidden="true"></div>

    <div class="time-line-container relative z-10 grid gap-0 min-w-0" id="experience-timeline">
      <ExperienceTimeLine entries={experienceEntries} card={true} />
    </div>

    <div class="skill-graph-section relative z-10 lg:sticky lg:top-8 self-start">
      <div class="text-lg font-semibold mb-2">Skill Areas</div>
      <SkillGraph entries={experienceEntries} />
    </div>
  </div>
</BaseLayout>

<script>
  const timeline = document.getElementById("experience-timeline");
  const overlay = document.getElementById("tendril-overlay");
  const cssLayer = document.getElementById("tendril-css-layer");
  const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-bar button[data-filter]");
  const cards = timeline ? Array.from(timeline.querySelectorAll<HTMLElement>("[data-type]")) : [];
  const bubbles = Array.from(document.querySelectorAll<SVGGElement>(".skill-bubble"));
  const hubs = Array.from(document.querySelectorAll<SVGGElement>(".area-hub"));
  const spokes = Array.from(document.querySelectorAll<SVGLineElement>(".spoke"));
  const graphSection = document.querySelector<HTMLElement>(".skill-graph-section");
  const showsTendrils = () => window.matchMedia("(min-width: 1024px)").matches;

  // Shared tendril tuning, referenced by both rendering engines so the curve
  // (and its colors) can only ever be defined in one place.
  const TENDRIL_COLORS = { work: "#0d9488", project: "#64748b" } as const;
  const CARD_X_INSET = 6; // how far inside the card's right edge the line starts
  const CURVE_DX_RATIO = 0.45; // control points pulled this fraction of the span out
  const CURVE_MIN_DX = 60; // ...but never closer than this, so short spans still bow
  const curveDx = (x1: number, x2: number) =>
    Math.max(Math.abs(x2 - x1) * CURVE_DX_RATIO, CURVE_MIN_DX);
  const tendrilColor = (card: HTMLElement) =>
    TENDRIL_COLORS[card.dataset.type === "project" ? "project" : "work"];

  // Prefer letting the compositor draw the connectors: CSS scroll-driven
  // animations (animation-timeline: scroll()) plus trig functions (hypot,
  // atan2) can position a line between a normally-scrolling card and the
  // sticky graph with zero per-frame JS, so it can never lag behind the
  // paint. Fall back to the old rAF-driven SVG overlay on browsers that
  // don't support one of those features yet.
  const supportsCssTendrils =
    typeof CSS !== "undefined" &&
    CSS.supports("animation-timeline: scroll()") &&
    CSS.supports("clip-path: shape(from 0px 0px, line to 1px 1px, close)");

  if (overlay) overlay.classList.toggle("hidden", supportsCssTendrils);
  if (cssLayer) cssLayer.classList.toggle("hidden", !supportsCssTendrils);

  function updateScrollMax() {
    document.documentElement.style.setProperty(
      "--scroll-max",
      `${Math.max(0, document.documentElement.scrollHeight - window.innerHeight)}px`
    );
  }

  // The graph panel is `sticky`, so its viewport position isn't a constant:
  // at scroll 0 it's still sitting in its natural document-flow position,
  // and only becomes pinned at --sticky-top once you've scrolled past that
  // natural offset. Replicate that same max() the browser does internally
  // so the bubble endpoint tracks the sticky transition too, not just the
  // already-pinned steady state. --graph-natural-top is measured by
  // temporarily forcing position:static (a standard trick — no paint
  // happens between the two synchronous reads, so no visible flicker).
  function updateStickyMetrics() {
    if (!graphSection) return;
    const prevPosition = graphSection.style.position;
    graphSection.style.position = "static";
    const naturalTop = graphSection.getBoundingClientRect().top + window.scrollY;
    graphSection.style.position = prevPosition;
    document.documentElement.style.setProperty("--graph-natural-top", `${naturalTop}px`);
    const stickyTop = parseFloat(getComputedStyle(graphSection).top);
    document.documentElement.style.setProperty(
      "--sticky-top",
      `${Number.isFinite(stickyTop) ? stickyTop : 32}px`
    );
  }

  function updateScrollMetrics() {
    updateScrollMax();
    updateStickyMetrics();
  }
  if (supportsCssTendrils) updateScrollMetrics();

  // Bubble positions only move relative to the viewport when the sticky
  // graph panel is transitioning in/out of its stuck state — cache them and
  // only re-measure when the panel itself has actually shifted, instead of
  // calling getBoundingClientRect() on every bubble every scroll frame.
  // Position is kept relative to the graph panel's own top (rather than the
  // viewport) since that relative offset is rigid regardless of whether the
  // panel is currently stuck.
  let bubblePointCache: { x: number; relY: number }[] | null = null;
  let lastGraphTop: number | null = null;
  let lastMeasuredGraphTop = 0;

  function bubblePoints() {
    const graphTop = graphSection ? graphSection.getBoundingClientRect().top : 0;
    if (!bubblePointCache || lastGraphTop !== graphTop) {
      lastGraphTop = graphTop;
      lastMeasuredGraphTop = graphTop;
      bubblePointCache = bubbles.map((b) => {
        const r = b.getBoundingClientRect();
        return { x: r.left + r.width / 2, relY: r.top + r.height / 2 - graphTop };
      });
    }
    return bubblePointCache;
  }

  // Reuse a pool of <path>/<div> elements across redraws instead of tearing
  // down and rebuilding the overlay every frame.
  const tendrilPool: SVGPathElement[] = [];
  function tendrilPath(i: number) {
    if (!tendrilPool[i]) {
      const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
      p.setAttribute("fill", "none");
      p.setAttribute("stroke-width", "1.75");
      p.setAttribute("stroke-opacity", "0.35");
      overlay?.appendChild(p);
      tendrilPool[i] = p;
    }
    return tendrilPool[i];
  }

  // The CSS connector is a single element per bubble, clipped to a thin
  // cubic-bezier band via clip-path: shape() — the same S-curve the JS
  // fallback strokes (control points pulled horizontally from each
  // endpoint). Only the y endpoints move during scroll; the shape's
  // coordinates reference those scroll-linked custom properties, so the
  // browser re-solves the curve every frame with no per-frame JS.
  const cssLinePool: HTMLDivElement[] = [];
  function cssLine(i: number) {
    if (!cssLinePool[i]) {
      const d = document.createElement("div");
      d.className = "tendril-line";
      cssLayer?.appendChild(d);
      cssLinePool[i] = d;
    }
    return cssLinePool[i];
  }

  // Scroll-spy drives selection by default (spyCard). Clicking a card sets
  // an override (selectedCard) that wins until the next scroll, at which
  // point scrolling resumes control — hovering used to fight the scroll-spy
  // for control, which made it hard to scroll while the mouse sat over the
  // timeline; a click-to-override model keeps both interactions available
  // without them stepping on each other.
  let selectedCard: HTMLElement | null = null;
  let hoverBubble: string | null = null;

  // Which card is "active" by default is resolved live, synchronously, as
  // whichever visible card is closest to vertical viewport-center (0 if the
  // center line falls inside the card). This intentionally isn't an
  // IntersectionObserver: that API is asynchronous and can be throttled by
  // the browser, so with a narrow trigger band a card can scroll all the way
  // through it before the observer gets around to reporting it — which
  // looks exactly like scrolling past a card without it ever getting
  // selected. A direct geometric check has no such latency.
  //
  // The first/last cards still need an explicit clamp on top of that: once
  // the page is pinned at the very top/bottom of its scroll range, there's
  // nowhere further to scroll for that card's center to ever line up with
  // viewport-center, so "closest to center" would otherwise keep favoring
  // whatever's nearer the middle instead.
  function resolveSpyCard(): HTMLElement | null {
    const visible = cards.filter((c) => !c.classList.contains("hidden"));
    if (!visible.length) return null;
    const atTop = window.scrollY <= 2;
    const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atTop) return visible[0];
    if (atBottom) return visible[visible.length - 1];
    const mid = window.innerHeight / 2;
    let best: HTMLElement | null = null;
    let bestDist = Infinity;
    for (const c of visible) {
      const r = c.getBoundingClientRect();
      const dist = mid < r.top ? r.top - mid : mid > r.bottom ? mid - r.bottom : 0;
      if (dist < bestDist) {
        bestDist = dist;
        best = c;
      }
    }
    return best;
  }

  const cardOf = () => selectedCard || resolveSpyCard();
  const skillsOfCard = (el: HTMLElement | null) =>
    el ? (el.dataset.skills || "").split(",").filter(Boolean) : [];

  function clearTendrils() {
    tendrilPool.forEach((p) => p.setAttribute("d", ""));
    cssLinePool.forEach((l) => l.classList.remove("on"));
  }

  function clearAll() {
    bubbles.forEach((b) => b.classList.remove("g-dim", "g-on"));
    hubs.forEach((h) => h.classList.remove("g-dim", "g-on"));
    spokes.forEach((s) => s.classList.remove("g-dim", "g-on"));
    cards.forEach((c) => c.classList.remove("skill-active", "opacity-40"));
    clearTendrils();
  }

  // Highlight a set of skills across the graph: bubbles, their parent hubs
  // (cascade), and the spokes. Cards are handled separately by render().
  function graphHighlight(skills: string[]) {
    const skillSet = new Set(skills);
    const areaSet = new Set<string>();
    bubbles.forEach((b) => {
      if (b.dataset.skill && skillSet.has(b.dataset.skill)) areaSet.add(b.dataset.area || "");
    });

    bubbles.forEach((b) => {
      const on = !!b.dataset.skill && skillSet.has(b.dataset.skill);
      b.classList.toggle("g-on", on);
      b.classList.toggle("g-dim", !on);
    });
    hubs.forEach((h) => {
      const on = !!h.dataset.area && areaSet.has(h.dataset.area);
      h.classList.toggle("g-on", on);
      h.classList.toggle("g-dim", !on);
    });
    spokes.forEach((s) => {
      const on = !!s.dataset.skill && skillSet.has(s.dataset.skill);
      s.classList.toggle("g-on", on);
      s.classList.toggle("g-dim", !on);
    });
  }

  function bezier(x1: number, y1: number, x2: number, y2: number, dx: number) {
    return `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
  }

  // Single source of truth for the card-side geometry both engines need: the
  // start point, the type color, and one control-point-carrying endpoint per
  // bubble the active card connects to. Only the y basis differs downstream —
  // the fixed SVG overlay works in viewport space (viewportY1), the CSS
  // scroll-driven path in document space (docY1) — so both are provided here.
  interface TendrilItem {
    x2: number;
    relY: number; // bubble center y, relative to the graph panel's own top
    dx: number;
  }
  interface TendrilLayout {
    x1: number;
    color: string;
    viewportY1: number;
    docY1: number;
    items: TendrilItem[];
  }
  function tendrilLayout(card: HTMLElement, skills: string[]): TendrilLayout {
    const rect = card.getBoundingClientRect();
    const x1 = rect.right - CARD_X_INSET;
    const midY = rect.top + rect.height / 2;
    const skillSet = new Set(skills);
    const points = bubblePoints();
    const items: TendrilItem[] = [];
    bubbles.forEach((b, idx) => {
      if (!b.dataset.skill || !skillSet.has(b.dataset.skill)) return;
      const { x: x2, relY } = points[idx];
      items.push({ x2, relY, dx: curveDx(x1, x2) });
    });
    return {
      x1,
      color: tendrilColor(card),
      viewportY1: midY,
      docY1: window.scrollY + midY,
      items,
    };
  }

  // JS-measured fallback: coordinates are plain viewport pixels (the overlay
  // is position:fixed), recomputed on scroll via the rAF loop below.
  function drawTendrilsJs(card: HTMLElement, skills: string[]) {
    if (!overlay) return;
    const { x1, color, viewportY1: y1, items } = tendrilLayout(card, skills);
    items.forEach(({ x2, relY, dx }, i) => {
      const y2 = lastMeasuredGraphTop + relY;
      const p = tendrilPath(i);
      p.setAttribute("d", bezier(x1, y1, x2, y2, dx));
      p.setAttribute("stroke", color);
    });
    for (let i = items.length; i < tendrilPool.length; i++) tendrilPool[i].setAttribute("d", "");
  }

  // CSS-driven path: set the endpoints as custom properties once (on card
  // switch / highlight change / resize) and let animation-timeline: scroll()
  // interpolate the card's viewport position every frame with no JS at all,
  // so it can never fall a frame behind the compositor's scroll.
  function drawTendrilsCss(card: HTMLElement, skills: string[]) {
    if (!cssLayer) return;
    const { x1, color, docY1, items } = tendrilLayout(card, skills);
    cssLayer.style.setProperty("--x1", `${x1}px`);
    cssLayer.style.setProperty("--card-top", `${docY1}px`);
    cssLayer.style.setProperty("--tendril-color", color);
    items.forEach(({ x2, relY, dx }, i) => {
      const line = cssLine(i);
      line.style.setProperty("--x2", `${x2}px`);
      line.style.setProperty("--bubble-rel-y", `${relY}px`);
      line.style.setProperty("--dx", `${dx}px`);
      line.classList.add("on");
    });
    for (let i = items.length; i < cssLinePool.length; i++) cssLinePool[i].classList.remove("on");
  }

  function drawTendrils(card: HTMLElement | null, skills: string[]) {
    if (!showsTendrils() || !card) {
      clearTendrils();
      return;
    }
    if (supportsCssTendrils) drawTendrilsCss(card, skills);
    else drawTendrilsJs(card, skills);
  }

  // Resolve the current highlight state from hover/scroll/bubble inputs.
  function render() {
    // Hovering a bubble: isolate that skill; fade cards that don't use it.
    if (hoverBubble) {
      graphHighlight([hoverBubble]);
      cards.forEach((c) => {
        const uses = skillsOfCard(c).includes(hoverBubble!);
        c.classList.remove("skill-active");
        c.classList.toggle("opacity-40", !uses);
      });
      clearTendrils();
      return;
    }
    // Otherwise the focused card drives everything. Only that one card is
    // emphasized — no co-highlighting of other cards that share a skill.
    const card = cardOf();
    if (!card) {
      clearAll();
      return;
    }
    const skills = skillsOfCard(card);
    graphHighlight(skills);
    cards.forEach((c) => {
      c.classList.toggle("skill-active", c === card);
      c.classList.remove("opacity-40");
    });
    drawTendrils(card, skills);
  }

  bubbles.forEach((bubble) => {
    const skill = bubble.dataset.skill;
    if (!skill) return;
    bubble.addEventListener("mouseenter", () => {
      hoverBubble = skill;
      render();
    });
    bubble.addEventListener("mouseleave", () => {
      if (hoverBubble === skill) hoverBubble = null;
      render();
    });
  });

  // A click override only lasts until the next scroll — then control goes
  // back to the scroll-spy (resolveSpyCard). Intentionally separate from
  // the tendril redraw loop below: it only needs to fire on an actual
  // selection change, not track every frame.
  let lastResolvedCard: HTMLElement | null = null;
  function onScrollUpdateSelection() {
    if (selectedCard) selectedCard = null;
    if (hoverBubble) return;
    const resolved = cardOf();
    if (resolved !== lastResolvedCard) {
      lastResolvedCard = resolved;
      render();
    }
  }
  window.addEventListener("scroll", onScrollUpdateSelection, { passive: true });
  onScrollUpdateSelection();

  // Connector endpoints are only re-measured on a highlight change, not
  // continuously — so if layout shifts for reasons unrelated to a highlight
  // change (web fonts swapping in late, images loading, initial simulation
  // layout settling) the snapshot goes stale until something else happens to
  // trigger a redraw. Watch the timeline's box size and force a fresh
  // measurement whenever it changes, which also covers the very first paint
  // being wrong before fonts finish loading.
  const resizeObserver = new ResizeObserver(() => {
    bubblePointCache = null;
    if (supportsCssTendrils) updateScrollMetrics();
    render();
  });
  if (timeline) resizeObserver.observe(timeline);
  resizeObserver.observe(document.body);
  document.fonts?.ready.then(() => {
    bubblePointCache = null;
    if (supportsCssTendrils) updateScrollMetrics();
    render();
  });

  // JS-fallback only: a plain `scroll` listener isn't enough during a fast
  // fling, since the browser coalesces/throttles scroll events far below the
  // paint rate, so the compositor keeps scrolling every frame while our
  // redraw only runs on the sparser events. Run a continuous rAF loop for as
  // long as scrolling is happening so the redraw cadence tracks the paint
  // cadence rather than however often `scroll` happens to fire. When
  // supportsCssTendrils is true none of this runs at all — the connector
  // position is entirely compositor-driven via animation-timeline: scroll().
  let rafId: number | null = null;
  let idleTimer: ReturnType<typeof setTimeout> | null = null;

  function redrawFrame() {
    if (!hoverBubble) {
      const card = cardOf();
      if (card) drawTendrils(card, skillsOfCard(card));
    }
    rafId = requestAnimationFrame(redrawFrame);
  }

  function startRedrawLoop() {
    if (rafId == null) rafId = requestAnimationFrame(redrawFrame);
    if (idleTimer != null) clearTimeout(idleTimer);
    idleTimer = setTimeout(() => {
      if (rafId != null) cancelAnimationFrame(rafId);
      rafId = null;
      idleTimer = null;
    }, 200);
  }

  function redrawOnMove() {
    if (supportsCssTendrils) render();
    else startRedrawLoop();
  }

  if (!supportsCssTendrils) {
    window.addEventListener("scroll", startRedrawLoop, { passive: true });
    window.addEventListener("wheel", startRedrawLoop, { passive: true });
    window.addEventListener("touchmove", startRedrawLoop, { passive: true });
  }

  window.addEventListener("resize", () => {
    bubblePointCache = null;
    if (supportsCssTendrils) updateScrollMetrics();
    render();
  });

  timeline?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    // Card truncate/expand.
    const btn = target.closest<HTMLButtonElement>(".toggle-expand");
    if (btn) {
      const detail = btn.previousElementSibling as HTMLElement | null;
      if (!detail) return;
      const expanded = detail.classList.toggle("expanded");
      btn.textContent = expanded ? "Show less" : "Show more";
      if (supportsCssTendrils) updateScrollMetrics();
      redrawOnMove();
      return;
    }

    // Clicking a link (e.g. the job's external URL) should just navigate,
    // not also toggle selection underneath it.
    if (target.closest("a")) return;

    const card = target.closest<HTMLElement>("[data-type]");
    if (!card || !cards.includes(card)) return;
    selectedCard = card;
    render();
  });

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      selectedCard = null;
      hoverBubble = null;
      clearAll();
      filterButtons.forEach((b) => b.classList.remove("btn-active"));
      btn.classList.add("btn-active");
      const filter = btn.dataset.filter;
      cards.forEach((el) => {
        el.classList.toggle("hidden", !(filter === "all" || el.dataset.type === filter));
      });
      if (supportsCssTendrils) updateScrollMetrics();
      render();
    });
  });
</script>

<style is:global>
  /* Drives --scroll-frac from 0 to 1 across the whole document's scroll
     range, purely via the compositor — no JS involved. Scoped globally
     since it targets :root/html, which Astro's per-component scoping
     wouldn't otherwise match. */
  @property --scroll-frac {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  :root {
    --scroll-max: 0px;
    --sticky-top: 32px;
    --graph-natural-top: 0px;
    /* Per-type accent colors, kept in sync with TENDRIL_COLORS in the script
       and skillAreas in experience.ts. Reused by the active-card ring and the
       filter buttons below so the teal/slate literals live in one place. */
    --type-work: #0d9488;
    --type-project: #64748b;
  }
  @supports (animation-timeline: scroll()) {
    @keyframes tendril-scroll-progress {
      from {
        --scroll-frac: 0;
      }
      to {
        --scroll-frac: 1;
      }
    }
    :root {
      animation: tendril-scroll-progress linear both;
      animation-timeline: scroll(root);
      animation-range: 0% 100%;
    }
  }

  /* Isolate is redundant with position:relative + z-10 already establishing
     a stacking context, but pins it down explicitly: the graph's highlight
     states toggle `opacity` on bubbles/hubs/spokes, which independently
     creates nested stacking contexts of their own, and this guarantees they
     stay contained rather than ever being compared against the tendril
     layer directly. */
  .skill-graph-section {
    isolation: isolate;
  }

  /* .tendril-line elements are created with document.createElement in
     client JS, so they never receive Astro's per-component scope attribute
     — these rules must stay global or they silently never match. */
  .tendril-overlay,
  .tendril-css-layer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Must stay positive: BaseLayout wraps the page in a plain, non-
       stacking-context div with an opaque background (.drawer-content), so
       a negative z-index here would paint this fixed layer behind that
       background and make it vanish entirely. 1 is still well below the
       graph panel's z-10. */
    z-index: 1;
  }

  /* Each connector fills the fixed overlay and is clipped to a thin band
     tracing a cubic bezier. Its endpoints are viewport-space pixels: the
     card side is a document-space y (--card-top) minus the live scroll
     offset (--scroll-px), so the shape tracks the scroll directly. */
  .tendril-line {
    position: absolute;
    inset: 0;
    background: var(--tendril-color, var(--type-work));
    opacity: 0;
    pointer-events: none;
  }
  .tendril-line.on {
    opacity: 0.35;
    --scroll-px: calc(var(--scroll-frac) * var(--scroll-max));
    /* The graph panel is sticky: its own viewport top is whichever is
       larger — its natural (unstuck) document position minus how far
       we've scrolled, or the pinned sticky offset once we've scrolled
       past that. This mirrors position:sticky's own behavior so the
       bubble endpoint stays correct through the stuck/unstuck transition,
       not just once already pinned. */
    --graph-viewport-top: max(var(--sticky-top), var(--graph-natural-top) - var(--scroll-px));
    --y1: calc(var(--card-top) - var(--scroll-px));
    --y2: calc(var(--graph-viewport-top) + var(--bubble-rel-y));
    --w: 1.75px;
    /* Trace the curve along its top edge, drop the stroke width, and trace
       back along the bottom edge to close a thin band. Control points sit
       horizontally out from each endpoint (x1+dx, x2-dx), giving the same
       S-shape the JS bezier() fallback draws. */
    clip-path: shape(
      from var(--x1) var(--y1),
      curve to var(--x2) var(--y2)
        with calc(var(--x1) + var(--dx)) var(--y1) / calc(var(--x2) - var(--dx)) var(--y2),
      line to var(--x2) calc(var(--y2) + var(--w)),
      curve to var(--x1) calc(var(--y1) + var(--w))
        with calc(var(--x2) - var(--dx)) calc(var(--y2) + var(--w)) /
          calc(var(--x1) + var(--dx)) calc(var(--y1) + var(--w)),
      close
    );
  }

  /* Graph highlight states (applied to SVG groups from the script). */
  .spokes .spoke,
  .hubs .area-hub,
  .skills .skill-bubble {
