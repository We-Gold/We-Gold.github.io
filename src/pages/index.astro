---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Weaver Goldman</div>
    <div class="text-3xl py-3 font-bold">AI/ML Engineer &amp; Data Science Master's Student @ WPI</div>
    <div class="py-2">
      <text class="text-lg">
        I'm Weaver, a Computer Science (BS) and Data Science (MS) student at Worcester Polytechnic Institute, building applied AI/ML systems across pharma, medtech, and space research.
      </text>
    </div>

    <div class="py-2">
      <text class="text-lg">
        This summer I'm an AI Engineering Intern at Regeneron Pharmaceuticals, building an auditable AI/ML observability platform on AWS that monitors 30+ models and tens of thousands of model events, along with an adaptive LLM benchmarking system that cuts API costs by more than 60%.
      </text>
    </div>

    <div class="py-2">
      <text class="text-lg">
        Previously, I built agentic AI-powered tools at Medtronic for automatically analyzing HUGO Surgical robot logs, and I've worked with the Laboratory of Spaceflight and Planetary Exploration (LSPE) at WPI since 2024, developing a NASA-contracted, data-driven space mission planning web application.
      </text>
    </div>
    <div class="my-8">
      <a class="btn hover:bg-teal-600 hover:border-teal-600 hover:text-white transition-colors duration-300" href="https://www.linkedin.com/in/weaver-goldman/" target="_blank">CONNECT ON LINKEDIN</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Latest Projects</div>
  </div>

  <HorizontalCard
    title="Scaling Diffusion Models to Large Sparse Graphs"
    img="/content/projects/diffusion-graphs.png"
    desc="4-person senior project (MQP) introducing Scale-MGD and SparserDiff, sparse discrete diffusion architectures with linear memory complexity for large graphs, plus RedditWalk, a new benchmark dataset, for molecule and protein generation in drug discovery."
    url="https://digital.wpi.edu/concern/student_works/kh04dv11x"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="#TeamGraduate AI"
    img="/content/projects/teamgraduate-ai.png"
    desc="A cloud-hosted LLM platform generating curriculum-aligned educational content for secondary e-learning in Namibia, with AI authoring tools embedded in WordPress that cut lesson creation time by 87.7%."
    url="https://github.com/We-Gold/teamgraduateai-supporting-materials"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="ankirai"
    desc="A CLI published to PyPI that transforms notes (PDFs and more) into Anki flashcards at lightning speed using any LLM provider."
    url="https://pypi.org/project/ankirai/"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Recent Blog Posts</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + post.slug}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
