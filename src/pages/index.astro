---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import ExperienceTimeLine from "../components/experience/ExperienceTimeLine.astro";
import { experienceEntries } from "../data/experience";
import { getCollection } from "astro:content";
import CardDeck from "../components/deck/CardDeck.astro";
import TeamGraduateCard from "../components/deck/cards/TeamGraduateCard.astro";
import OuroborosCard from "../components/deck/cards/OuroborosCard.astro";
import DiffusionCard from "../components/deck/cards/DiffusionCard.astro";
import MedtronicCard from "../components/deck/cards/MedtronicCard.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
const workOnly = experienceEntries.filter((e) => e.type === "work").slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home" wide={true} fillWidth={true}>
  <div class="pb-6 mt-5 max-w-[900px]">
    <div class="text-5xl font-bold">Weaver Goldman</div>
    <div class="text-3xl py-3 font-bold">AI/ML Engineer &amp; Data Science Master's Student @ WPI</div>
    <div class="py-2">
      <text class="text-lg">
        I'm Weaver, a Computer Science (BS) and Data Science (MS) student at Worcester Polytechnic Institute, building applied AI/ML systems across pharma, medtech, and space research.
      </text>
    </div>

    <div class="py-2">
      <text class="text-lg">
        This summer I was an AI/ML Engineering Intern at Regeneron Pharmaceuticals, where I built an auditable AI/ML observability platform on AWS that monitors 30+ models across 3 pilot teams, along with an adaptive LLM benchmarking system that cuts API costs by more than 60%.
      </text>
    </div>

    <div class="py-2">
      <text class="text-lg">
        Previously, I built agentic AI-powered tools at Medtronic for automatically analyzing HUGO Surgical robot logs, and I've worked with the Laboratory of Spaceflight and Planetary Exploration (LSPE) at WPI since 2024, building a mission planning web app under contract with NASA JPL.
      </text>
    </div>
    <div class="mt-6">
      <a class="btn hover:bg-teal-600 hover:border-teal-600 hover:text-white transition-colors duration-300" href="https://www.linkedin.com/in/weaver-goldman/" target="_blank">CONNECT ON LINKEDIN</a>
    </div>
  </div>

  <section class="mb-16">
    <div class="text-3xl w-full font-bold">What I Build</div>
    <p class="text-lg opacity-80 mt-2 mb-6">A few projects that show how I work, from research models to LLM tools in production.</p>
    <CardDeck>
      <MedtronicCard />
      <OuroborosCard />
      <DiffusionCard />
      <TeamGraduateCard />
    </CardDeck>
  </section>

  <div class="py-2 mb-10">
    <div class="text-3xl w-full font-bold mb-4">Recent Experience</div>
    <div class="time-line-container grid gap-2">
      <ExperienceTimeLine entries={workOnly} compact={true} />
    </div>
    <a href="/experience" class="link link-hover text-teal-700 inline-block mt-2">View full experience &rarr;</a>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Latest Projects</div>
  </div>

  <HorizontalCard
    title="Scaling Diffusion Models to Large Sparse Graphs"
    img="/content/projects/diffusion-graphs.png"
    desc="4-person senior project (MQP) introducing Scale-MGD and SparserDiff, sparse discrete diffusion architectures with linear memory complexity for large graphs, plus RedditWalk, a new benchmark dataset, for molecule and protein generation in drug discovery."
    url="https://digital.wpi.edu/concern/student_works/kh04dv11x"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="ankirai"
    desc="A CLI published to PyPI that transforms notes (PDFs and more) into Anki flashcards at lightning speed using any LLM provider."
    url="https://pypi.org/project/ankirai/"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Recent Blog Posts</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + post.slug}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
