---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardDeck from "../components/deck/CardDeck.astro";
import TeamGraduateCard from "../components/deck/cards/TeamGraduateCard.astro";
import OuroborosCard from "../components/deck/cards/OuroborosCard.astro";
import DiffusionCard from "../components/deck/cards/DiffusionCard.astro";
import MedtronicCard from "../components/deck/cards/MedtronicCard.astro";
import RegeneronCard from "../components/deck/cards/RegeneronCard.astro";

// Where to go after the deck: each link says why a visitor would click it.
const nextSteps = [
  { title: "Experience", desc: "See all of my roles and research projects.", href: "/experience", external: false },
  { title: "Resume", desc: "View or download my resume.", href: "/cv", external: false },
  { title: "GitHub", desc: "Explore all of my public projects.", href: "https://github.com/We-Gold", external: true },
];
---

<BaseLayout sideBarActiveItemID="home" fillWidth={true}>
  <div class="pb-6 mt-5">
    <div class="text-5xl font-bold">Weaver Goldman</div>
    <div class="text-3xl py-3 font-bold">AI/ML Engineer &amp; Data Science Master's Student @ WPI</div>
    <div class="py-2">
      <text class="text-lg">
        I'm Weaver, a Computer Science (BS) and Data Science (MS) student at Worcester Polytechnic Institute, building applied AI/ML systems across pharma, medtech, and space research.
      </text>
    </div>
    <div class="py-2 text-lg opacity-80">Graduating May 2027.</div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn hover:bg-teal-600 hover:border-teal-600 hover:text-white transition-colors duration-300" href="https://www.linkedin.com/in/weaver-goldman/" target="_blank">CONNECT ON LINKEDIN</a>
      <a class="btn btn-outline hover:bg-teal-600 hover:border-teal-600 hover:text-white transition-colors duration-300" href="/cv">VIEW RESUME</a>
    </div>
  </div>

  <section class="mb-16">
    <div class="text-3xl w-full font-bold mb-5">Recent Experience</div>
    <CardDeck>
      <RegeneronCard />
      <MedtronicCard />
      <OuroborosCard />
      <DiffusionCard />
      <TeamGraduateCard />
    </CardDeck>
  </section>

  <section class="mb-16">
    <div class="text-3xl w-full font-bold mb-6">Learn More</div>
    <div class="grid gap-4 md:grid-cols-3">
      {
        nextSteps.map((step) => (
          <a
            href={step.href}
            target={step.external ? "_blank" : "_self"}
            rel={step.external ? "noopener noreferrer" : undefined}
            class="group flex flex-col gap-2 rounded-2xl border-2 border-base-300 p-6 transition-colors duration-300 hover:border-teal-600"
          >
            <span class="flex items-center justify-between text-xl font-bold group-hover:text-teal-700">
              {step.title}
              <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">{step.external ? "↗" : "→"}</span>
            </span>
            <span class="opacity-80">{step.desc}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
