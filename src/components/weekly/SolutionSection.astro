---
// Wraps everything that gives the answer away, so the reader chooses when to
// stop thinking.
//
// A native <details> rather than a React island: the reveal has to work with
// no JavaScript, and an .astro component takes its children as a real slot,
// so the <Solution client:load /> island inside stays its own island.
//
// Its presence in the .mdx body is also what tells the layout a solution
// exists — see src/pages/weekly/[slug].astro — so there's no frontmatter flag
// to forget to set.
---

<details class="not-prose my-8 rounded-lg border border-base-300 bg-base-100">
    <summary
        class="flex cursor-pointer list-none items-center gap-3 px-5 py-4 text-xl font-bold"
    >
        <svg
            class="chevron h-5 w-5 shrink-0 transition-transform duration-200"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
        >
            <path
                fill-rule="evenodd"
                d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z"
                clip-rule="evenodd"></path>
        </svg>
        Reveal solution
    </summary>
    <div class="prose prose-lg max-w-none px-5 pb-5">
        <slot />
    </div>
</details>

<style>
    /* Both are needed: the pseudo-element for WebKit, `list-style` for
       everyone else. */
    summary::-webkit-details-marker {
        display: none;
    }
    summary {
        list-style: none;
    }
    details[open] .chevron {
        transform: rotate(90deg);
    }
</style>
